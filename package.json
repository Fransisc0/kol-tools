{
  "name": "kol-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Privacy-conscious, open-source tools for Kingdom of Loathing players.",
  "license": "BSD-3-Clause",
  "homepage": "https://fransisc0.github.io/kol-tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fransisc0/kol-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Fransisc0/kol-tools/issues"
  },
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "predev": "npm run prepare:data",
    "dev": "vite",
    "clean": "rimraf dist coverage .vite public/data",
    "prepare:data": "tsx scripts/build-static-data.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:client": "vite build",
    "build:hub": "node scripts/build-pages.mjs",
    "build": "npm run clean && npm run prepare:data && npm run build:client && npm run build:hub",
    "preview": "vite preview --outDir dist/pages/tcrs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:data": "npm run prepare:data && tsx scripts/verify-datasets.ts",
    "verify:data-determinism": "tsx scripts/verify-static-data.ts",
    "verify:privacy": "node scripts/privacy-scan.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run verify:data && npm run verify:data-determinism && npm run build && npm run verify:pages && npm run verify:privacy && npm audit --audit-level=high && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  }
}

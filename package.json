{
  "name": "kol-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "clean": "rimraf dist coverage .vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:client": "vite build",
    "build:hub": "node scripts/build-pages.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server/server.cjs",
    "build": "npm run clean && npm run build:client && npm run build:hub && npm run build:server",
    "start": "cross-env NODE_ENV=production node dist/server/server.cjs",
    "preview": "vite preview --outDir dist/pages/tcrs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:data": "cross-env TCRS_OFFLINE=true tsx scripts/verify-datasets.ts",
    "verify:privacy": "node scripts/privacy-scan.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run verify:pages && npm run verify:privacy && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/rollup-win32-x64-msvc": "^4.63.3",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  }
}
